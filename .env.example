# -------------------------------------------
# 🔧 Ginva Protocol - Environment Variables
# -------------------------------------------
# Copy this file to .env and fill in your values

# ===========================================
# 🖥️ SOLANA NETWORK CONFIGURATION
# ===========================================
ANCHOR_PROVIDER_CLUSTER=devnet
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
ANCHOR_WALLET=~/.config/solana/id.json

# ===========================================
# 🏛️ GINVA PROGRAM IDS
# ===========================================
# Generated after anchor build (Devnet)
VITE_GINVA_PROGRAM_ID=2SiGJi9VkD96oWLNizmMkGFwFpHq1tEETVqrLCezWKou
ANCHOR_GINVA_PROGRAM_ID=2SiGJi9VkD96oWLNizmMkGFwFpHq1tEETVqrLCezWKou

# ===========================================
# 💰 TREASURY WALLETS (Required for Deploy)
# ===========================================
# Generate wallets and add pubkeys here before deploy
# Generate wallets via: solana-keygen new -o tests/admin.json
GINVA_CAPITAL_WALLET=<YOUR_CAPITAL_WALLET_PUBKEY>
GINVA_OPS_WALLET=<YOUR_OPS_WALLET_PUBKEY>
GINVA_REVENUE_WALLET=<YOUR_REVENUE_WALLET_PUBKEY>
GINVA_ADMIN_WALLET=<YOUR_ADMIN_WALLET_PUBKEY>

# ===========================================
# 🤖 KEEPER BOT CONFIGURATION
# ===========================================
# Required to run Keeper Bot
KEEPER_WALLET_PATH=~/.config/solana/keeper.json
KEEPER_MIN_PROFIT_USDC=0.5
KEEPER_MAX_GAS_SOL=0.01

# RPC for Keeper (recommend private RPC to avoid rate limit)
KEEPER_RPC_URL=https://api.devnet.solana.com

# ===========================================
# 🔮 ORACLE CONFIGURATION (Pyth Network)
# ===========================================
# Pyth Price Feed IDs - get from https://pyth.network/developers/price-feeds
# Devnet
PYTH_SOL_USD_FEED_ID=4NmL4bWthM8tVEqyXbJ6RY5uZG1GSshPYsY6jwDXqNMU
PYTH_BTC_USD_FEED_ID=GVXRSBjFk6e9J3v8fBpFrx8mb97Ykz5xXWL6na7RqRV7
PYTH_ETH_USD_FEED_ID=4U9BvYb4HxoRyWpe23u1YymYfqKxp4HCoq3d3F96xYnE

# ===========================================
# 🌐 FRONTEND / WEB3 CONFIG
# ===========================================
# If using Frontend in app/, copy VITE_ values to app/.env
VITE_SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com
VITE_SOLANA_NETWORK=devnet
VITE_PROTOCOL_NAME=Ginva
VITE_PROTOCOL_VERSION=2.0.0

# ===========================================
# 📊 MONITORING & ALERTS (Optional)
# ===========================================
# Telegram Bot for alerts (optional)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=-100123456789

# Discord Webhook for Logs
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ===========================================
# 🤖 BOT CONFIGURATION
# ===========================================
# RPC URL for Bot (use Devnet for testing)
RPC_URL=https://api.devnet.solana.com

# Fallback RPCs (auto-switch if primary fails) - use only trusted RPCs
FALLBACK_RPC=https://rpc.ankr.com/solana
FALLBACK2_RPC=https://solana.api.pocket.network

# ===========================================
# 🔐 WALLET SECURITY ( REQUIRED )
# ===========================================
# RECOMMENDED: Use PRIVATE_KEY instead of keypair.json for better security
# Generate pubkey: solana-keygen pubkey ~/.config/solana/id.json
# NEVER commit private key!
PRIVATE_KEY=your_base58_encoded_private_key_here

# [Deprecated] Use PRIVATE_KEY instead
# KEYPAIR_PATH=./keypair.json

# ===========================================
# 🚨 LIQUIDATION ALERTS
# ===========================================
# Telegram Bot (created via @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_or_group_id

# Health Factor threshold for alerts (1.05 = 5% above liquidation)
LIQUIDATION_THRESHOLD=1.05

# ===========================================
# 🔐 SECURITY (Never commit real keys!)
# ===========================================
# For encrypting Private Keys or sensitive API Keys
# Use .env.local or Secrets Manager instead
