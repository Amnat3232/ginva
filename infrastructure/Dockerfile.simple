# Minimal Dockerfile for faster builds
FROM rust:1.89.0

WORKDIR /app

# Install system deps
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libudev-dev \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Solana CLI
RUN curl -sSfL https://release.anza.xyz/v1.18.26/install | sh

# Install Anchor CLI (use stable version to avoid edition2024)
RUN cargo install --git https://github.com/coral-xyz/anchor --tag v0.29.0 anchor-cli --locked

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

# Copy source
COPY . .

# Install dependencies and build
RUN npm install && \
    anchor build

CMD ["anchor", "test"]