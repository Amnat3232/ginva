{
  "name": "ginva-protocol",
  "version": "2.0.0",
  "description": "Ginva DeFi Protocol - Task-Based Liquidation with Auto-Swap (Production Ready)",
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "build": "anchor build",
    "build:docker": "./docker-build.sh",
    "export:idl": "cp target/idl/ginva.json ./ginva.json 2>/dev/null || echo 'Build first: anchor build'",
    "test": "anchor test",
    "test:extend": "ts-node tests/extend_loan_simple.test.ts",
    "test:docker": "docker-compose up --build test",
    "test:liquidation": "anchor test --grep 'Liquidation'",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "deploy:mainnet": "anchor deploy --provider.cluster mainnet",
    "setup:devnet": "ts-node scripts/setup-devnet.ts",
    "demo:full": "ts-node scripts/demo-full-flow.ts",
    "bot:start": "ts-node auto-swap-bot.ts",
    "bot:test": "ts-node scripts/test-bot.ts",
    "demo:visual": "ts-node scripts/visual-demo.ts",
    "docker:shell": "docker-compose run --rm shell",
    "docker:clean": "docker-compose down -v && docker system prune -f"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@pythnetwork/client": "^2.19.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@solana/spl-token": "^0.1.8",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.32",
    "@solana/wallet-adapter-wallets": "^0.16.10",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.90.21",
    "bn.js": "^5.2.1",
    "bs58": "^6.0.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.3.1",
    "gsap": "^3.14.2",
    "lenis": "^1.3.18",
    "lucide-react": "^0.577.0",
    "playwright": "^1.59.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^2.0.7",
    "text-encoding-utf-8": "^1.0.2",
    "three": "^0.183.2",
    "whatwg-url": "^16.0.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "chai": "^4.3.4",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.0",
    "mocha": "^11.7.5",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
