# ⚠️ IMPORTANT: These are dummy/development values only!
# Never commit real secrets - use .env.local for local dev
# and CI/CD secrets for production

# Supabase (Anon key is designed to be public, but use RLS)
NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy-anon-key-for-development

# Solana RPC (public endpoint - safe to expose)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
