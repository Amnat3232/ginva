# RPC Configuration
RPC_URL=https://api.devnet.solana.com

# Carbium Infrastructure (Hackathon - sub-50ms latency + MEV protection)
CARBIUM_RPC=https://rpc.carbium.io
CARBIUM_WSS=wss://wss-rpc.carbium.io
USE_CARBIUM=true

# Program ID (Devnet)
PROGRAM_ID=2SiGJi9VkD96oWLNizmMkGFwFpHq1tEETVqrLCezWKou

# Private Key Configuration (CHOOSE ONE METHOD)
# Method 1: Use PRIVATE_KEY environment variable (RECOMMENDED for security)
# Format: JSON array of secret key bytes (from solana keypair output)
# Example: PRIVATE_KEY=[42,13,244,...,189]
# PRIVATE_KEY=[...your secret key array...]

# Method 2: Use keypair file path (LESS SECURE - ensure file is in .gitignore)
# KEYPAIR_PATH=./keypair.json

# IDL Path
IDL_PATH=../target/idl/ginva.json

# Bot Configuration (optional - defaults are in code)
# TRIGGER_MIN_PROFIT=0.5
# HUNTER_MIN_DISCOUNT=6
# HUNTER_MAX_INVESTMENT=10000
# PRIORITY_FEE=10000

# SECURITY WARNING:
# - Never commit .env files or keypair files to version control
# - Use PRIVATE_KEY environment variable in production
# - Keep your keypair file in a secure location
# - Rotate keys immediately if compromised
