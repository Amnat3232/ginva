FROM rust:1.85.0

WORKDIR /app

RUN apt-get update && apt-get install -y \
    pkg-config libssl-dev libudev-dev curl git build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Solana CLI
RUN curl -sSfL https://release.anza.xyz/v1.18.26/install | sh

# Install Anchor CLI
RUN cargo install --git https://github.com/coral-xyz/anchor --tag v0.30.0 anchor-cli --locked 2>/dev/null || \
    cargo install --git https://github.com/coral-xyz/anchor anchor-cli --locked

ENV PATH="/root/.cargo/bin:$PATH"

COPY . .

RUN rm -f Cargo.lock

CMD ["cargo", "build-sbf"]