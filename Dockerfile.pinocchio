# Build Pinocchio Solana Program with Docker
# Using Solana's Rust toolchain (1.75.0) for compatibility
FROM solanalabs/rust:1.75.0

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config libssl-dev libudev-dev curl git build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Solana CLI tools (for cargo-build-sbf)
RUN curl -sSfL https://release.anza.xyz/v1.18.26/install | sh

ENV PATH="/root/.local/share/solana/install/active_release/bin:$PATH"

# Copy program files only
COPY programs/ginva-pinocchio/ ./ginva-pinocchio/
COPY rust-toolchain.toml ./

# Build without workspace
WORKDIR /app/ginva-pinocchio

# Force remove any lock file with version 4
RUN rm -f Cargo.lock

# Build (uses Solana's bundled Rust 1.75)
RUN cargo build-sbf

# Output  
RUN ls -la target/deploy/