# Build Pinocchio Solana Program with Docker
FROM rust:1.85.0

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config libssl-dev libudev-dev curl git build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Solana CLI
RUN curl -sSfL https://release.anza.xyz/v1.18.26/install | sh

ENV PATH="/root/.local/share/solana/install/active_release/bin:$PATH"

# Copy source
COPY programs/ginva-pinocchio/ ./programs/ginva-pinocchio/
COPY rust-toolchain.toml ./

# Build
RUN rm -f Cargo.lock && cargo build-bpf -p ginva-pinocchio

# Output
CMD ["ls", "-la", "target/release/"]